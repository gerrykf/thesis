NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=1Panel-mysql-c9zl
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mysql_ESQSJ2
DB_NAME=health_management

# JWT配置
JWT_SECRET=health_system_jwt_secret_key_2024
JWT_EXPIRES_IN=7d

# 日志配置
